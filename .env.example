# Nucleus environment. Copy to .env.local (gitignored) and fill in.
#
# Nucleus is ONE app: the UI + auth AND the retrieval/answer engine run together
# (in-process — there is no separate engine service and no ENGINE_URL).

# ── Answer model (composes the grounded answers) ────────────────────────────────
# OpenAI-compatible chat API. Default is DeepSeek (cheap + reliable). To use Gemini
# as the answer model instead, point LLM_BASE_URL at Google's OpenAI-compat endpoint
# (https://generativelanguage.googleapis.com/v1beta/openai), set LLM_MODEL to a
# Gemini model, and put the Gemini key in LLM_API_KEY. Azure/Vertex work the same way.
LLM_PROVIDER=deepseek
LLM_API_KEY=your-answer-model-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ── Documents — Gemini File Search (managed RAG for UPLOADED docs) ──────────────
# Gemini reads PDFs/scans natively and returns cited chunks. GEMINI_API_KEY (some
# Google SDKs read GOOGLE_API_KEY instead — set both to the same value to be safe).
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-gemini-api-key
# The File Search store id (create once: POST https://generativelanguage.googleapis.com/v1beta/fileSearchStores)
GEMINI_FILE_SEARCH_STORE=fileSearchStores/your-store-id
# Model for File Search queries (free, separate quota from generate).
GEMINI_FS_MODEL=gemini-2.5-flash-lite

# ── Supabase (logins + user accounts + per-user data) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, keep private
# Some server paths read SUPABASE_URL; set it to the same value as the public URL.
SUPABASE_URL=https://your-ref.supabase.co

# ── Internal ───────────────────────────────────────────────────────────────────
# Shared secret guarding the internal /api/embed function (the local document
# embedder runs in its own serverless function; the app calls it server-to-server).
INTERNAL_EMBED_TOKEN=any-long-random-string
# Optional: the app's own base URL for that internal server-to-server call. On Vercel
# it's auto-derived from VERCEL_URL — only set this for a custom host or local runs.
# NUCLEUS_SELF_URL=https://your-app.example.com

# Pins "today" so date-based demo numbers stay consistent (optional; remove for live).
ASSISTANT_TODAY=2026-06-09
