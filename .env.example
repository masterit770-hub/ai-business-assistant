# Nucleus environment. Copy to .env.local (gitignored) and fill in.

# URL of the Contract-Retriever-RAG engine's /api/ask endpoint.
# The Nucleus /api/ask route proxies questions here (real routing + hybrid
# SQL/RAG retrieval + grounded generation + validateAnswer). Defaults to the
# engine running in dev on :3100 if unset.
ENGINE_URL=http://localhost:3100/api/ask
