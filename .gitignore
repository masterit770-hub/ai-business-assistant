# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# pulled prod env for local in-process evals (carries the LLM key) — NEVER commit.
# Re-derive with: vercel env pull .vercel-prod.env --environment=production
.vercel-prod.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.secrets/

# Supabase CLI local artifacts
supabase/.temp/
.branches/

# OCR trained data (large, regenerable)
eng.traineddata
heb.traineddata

# Raw test-evidence logs may contain real client data (names from her sheets) — keep local, never commit.
docs/testing/evidence/

# Client PII — her ENTIRE uploaded corpus (youth-name scheduling sheets, the family-court case-file
# PDF, the Carter story, the school-data CSVs) is the client's private data and MUST NEVER be committed
# or deployed. Ignore ALL of data/ (the files stay on disk for local evals; they're just never tracked).
# Root-level raw grid dumps (grid-*.txt) are the same PII in another form — ignore those too.
data/
grid-*.txt
